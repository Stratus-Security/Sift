<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSource>false</IncludeSource>
    <IncludeSymbols>false</IncludeSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep ad hoc RID/AOT restores from rewriting the RID-neutral locks used by CI. -->
    <LockRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</LockRuntimeIdentifier>
    <LockRuntimeIdentifier Condition="'$(LockRuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != ''">$(RuntimeIdentifiers)</LockRuntimeIdentifier>
    <NuGetLockFilePath Condition="'$(LockRuntimeIdentifier)' != '' and '$(NuGetLockFilePath)' == ''">$(MSBuildThisFileDirectory)artifacts/locks/$(MSBuildProjectName).$(LockRuntimeIdentifier).packages.lock.json</NuGetLockFilePath>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <PathMap Condition="'$(ContinuousIntegrationBuild)' == 'true'">$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
