<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId Condition="'$(CommercialBuild)' != 'true'">Stratus.Sift.Contracts</PackageId>
    <PackageId Condition="'$(CommercialBuild)' == 'true'">Stratus.Sift.Contracts.Commercial</PackageId>
    <Version>0.3.0</Version>
    <Authors>Stratus</Authors>
    <Description>Neutral contracts for Stratus Sift scan requests, observations, progress and summaries.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression Condition="'$(CommercialBuild)' != 'true'">AGPL-3.0-only</PackageLicenseExpression>
    <PackageLicenseFile Condition="'$(CommercialBuild)' == 'true'">LICENSE.txt</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
  <ItemGroup Condition="'$(CommercialBuild)' == 'true' and Exists('$(CommercialPackageLicenseFile)')">
    <None Include="$(CommercialPackageLicenseFile)" Pack="true" PackagePath="LICENSE.txt" Visible="false" />
  </ItemGroup>
  <Target Name="ValidateCommercialPack" BeforeTargets="Pack" Condition="'$(CommercialBuild)' == 'true' and '$(CommercialPackageLicenseFile)' == ''">
    <Error Text="Commercial builds require an approved CommercialPackageLicenseFile supplied by private CI." />
  </Target>
</Project>


