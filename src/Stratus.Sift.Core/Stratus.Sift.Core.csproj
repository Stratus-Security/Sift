<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId Condition="'$(CommercialBuild)' != 'true'">Stratus.Sift.Core</PackageId>
    <PackageId Condition="'$(CommercialBuild)' == 'true'">Stratus.Sift.Core.Commercial</PackageId>
    <Version>0.1.0</Version>
    <Authors>Stratus</Authors>
    <Description>Tenant-neutral content matching and filesystem scanning engine for Stratus Sift.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression Condition="'$(CommercialBuild)' != 'true'">AGPL-3.0-only</PackageLicenseExpression>
    <PackageLicenseFile Condition="'$(CommercialBuild)' == 'true'">LICENSE.txt</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stratus.Sift.Contracts\Stratus.Sift.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Defaults\Data\**\*.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
  <ItemGroup Condition="'$(CommercialBuild)' == 'true' and Exists('$(CommercialPackageLicenseFile)')">
    <None Include="$(CommercialPackageLicenseFile)" Pack="true" PackagePath="LICENSE.txt" Visible="false" />
  </ItemGroup>
  <Target Name="ValidateCommercialPack" BeforeTargets="Pack" Condition="'$(CommercialBuild)' == 'true' and '$(CommercialPackageLicenseFile)' == ''">
    <Error Text="Commercial builds require an approved CommercialPackageLicenseFile supplied by private CI." />
  </Target>
</Project>
