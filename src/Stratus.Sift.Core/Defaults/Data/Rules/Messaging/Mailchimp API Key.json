{
  "Name": "Mailchimp API Key",
  "Description": "Detects Mailchimp API Keys (Hex MD5 + Data Center suffix)",
  "Label": "General",
  "Severity": "Medium",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "-us1",
        "-us2",
        "-us3",
        "-us4",
        "-us5",
        "-us6",
        "-us7",
        "-us8",
        "-us9",
        "-us10",
        "-us11",
        "-us12",
        "-us13",
        "-us14",
        "-us15",
        "-us16",
        "-us17",
        "-us18",
        "-us19",
        "-us20"
      ],
      "Patterns": [
        "\\b[0-9a-f]{32}-us[0-9]{1,2}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "MailchimpApiKey"
}
