{
  "Name": "Slack Webhook",
  "Description": "Detects Slack Incoming Webhook URLs (hooks.slack.com)",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "hooks.slack.com"
      ],
      "Patterns": [
        "\\b(https?://)?hooks\\.slack\\.com/services/T[a-zA-Z0-9_]{8,13}/B[a-zA-Z0-9_]{8,13}/[a-zA-Z0-9_]{24,32}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
