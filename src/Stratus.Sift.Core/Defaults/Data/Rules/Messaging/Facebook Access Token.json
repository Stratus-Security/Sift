{
  "Name": "Facebook Access Token",
  "Description": "Detects Facebook Graph API Access Tokens (EAA... prefix)",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "EAA"
      ],
      "Patterns": [
        "\\bEAA[a-zA-Z0-9]{150,}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
