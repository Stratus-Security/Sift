{
  "Name": "Twilio Credentials",
  "Description": "Detects assigned Twilio Auth Tokens and API Secrets without treating public SIDs as credentials.",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "twilio"
      ],
      "Patterns": [
        "(?:TWILIO[_\\-.]?(?:AUTH[_\\-.]?TOKEN|API[_\\-.]?SECRET))[\"']?\\s*[:=]\\s*[\"'`]?[^\\s\"'`{},;]{1,4096}"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "Twilio"
}
