{
  "Name": "AWS Session Token",
  "Description": "Detects temporary AWS session tokens assigned through SDK, CLI, and environment-variable conventions.",
  "Label": "Cloud",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "aws_session_token",
        "AWS_SESSION_TOKEN"
      ],
      "Patterns": [
        "(?:aws_session_token|AWS_SESSION_TOKEN)\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{80,4096}[\"']?"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "AwsSessionToken"
}
