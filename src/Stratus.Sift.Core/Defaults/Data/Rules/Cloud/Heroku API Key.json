{
  "Name": "Heroku API Key",
  "Description": "Detects Heroku API Keys (UUID format) assigned to Heroku-related variables",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "heroku"
      ],
      "Patterns": [
        "(?<=(?i)heroku[a-z0-9_]*\\s*[:=]\\s*)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "Heroku"
}
