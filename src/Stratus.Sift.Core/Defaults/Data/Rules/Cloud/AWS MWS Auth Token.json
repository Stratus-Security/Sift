{
  "Name": "AWS MWS Auth Token",
  "Description": "Detects legacy Amazon MWS Auth Tokens (amzn.mws.UUID)",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "amzn.mws."
      ],
      "Patterns": [
        "\\bamzn\\.mws\\.[a-f0-9-]{36}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
