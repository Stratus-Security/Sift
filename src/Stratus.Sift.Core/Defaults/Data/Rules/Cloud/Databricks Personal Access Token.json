{
  "Name": "Databricks Personal Access Token",
  "Description": "Detects Databricks personal access tokens with the dapi prefix.",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "dapi"
      ],
      "Patterns": [
        "\\bdapi[a-zA-Z0-9]{32}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
