{
  "Name": "AWS Secret Key",
  "Description": "Detects AWS Secret Access Keys",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "aws_secret_access_key",
        "aws_secret_key",
        "secret_key"
      ],
      "Patterns": [
        "(?<![A-Za-z0-9/+=])[A-Za-z0-9/+=]{40}(?![A-Za-z0-9/+=])"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EntropyThreshold": 4.5
}
