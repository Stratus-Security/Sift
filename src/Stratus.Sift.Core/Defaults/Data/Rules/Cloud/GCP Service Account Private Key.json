{
  "Name": "GCP Service Account Private Key",
  "Description": "Detects the actual Private Key inside a Google Cloud Service Account JSON file",
  "Label": "General",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "private_key",
        "googleapis.com"
      ],
      "Patterns": [
        "-----BEGIN PRIVATE KEY-----[a-zA-Z0-9\\s\\+\\/=]+-----END PRIVATE KEY-----"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
