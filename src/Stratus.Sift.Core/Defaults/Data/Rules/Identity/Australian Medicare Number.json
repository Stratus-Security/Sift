{
  "Enabled": false,
  "Name": "Australian Medicare Number",
  "Description": "Opt-in detection of checksum-valid Australian Medicare card numbers when Medicare context is present.",
  "Label": "Identity",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "Medicare",
        "Medicare number"
      ],
      "Patterns": [
        "(?<![0-9])[0-9]{4}[ -]?[0-9]{5}[ -]?[0-9]{1,2}(?![0-9])"
      ],
      "IncludedExtensions": [
        ".txt",
        ".log",
        ".csv",
        ".tsv",
        ".json",
        ".xml",
        ".yaml",
        ".yml",
        ".pdf",
        ".docx",
        ".xlsx"
      ]
    }
  ],
  "Validator": "AustralianMedicare",
  "EnableLlmValidation": false
}
