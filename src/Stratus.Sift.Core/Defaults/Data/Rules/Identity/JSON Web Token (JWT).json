{
  "Name": "JSON Web Token (JWT)",
  "Description": "Detects signed and unsecured compact JSON Web Tokens.",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "eyJ"
      ],
      "Patterns": [
        "(?<![A-Za-z0-9_-])eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]*(?![A-Za-z0-9_-])"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "Jwt"
}
