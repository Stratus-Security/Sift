{
  "Name": "Stripe Secret Key",
  "Description": "Detects Stripe Secret Keys and Restricted Keys",
  "Label": "General",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "sk_live_",
        "sk_test_",
        "rk_live_",
        "rk_test_"
      ],
      "Patterns": [
        "\\b(sk|rk)_(live|test)_[0-9a-zA-Z]{24,99}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "StripeSecretKey"
}
