{
  "Enabled": false,
  "Name": "International Bank Account Number",
  "Description": "Opt-in detection of checksum-valid International Bank Account Numbers (IBANs).",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Patterns": [
        "(?<![A-Z0-9])[A-Z]{2}[0-9]{2}(?:[ ]?[A-Z0-9]){11,30}(?![A-Z0-9])"
      ],
      "IncludedExtensions": [
        ".txt",
        ".log",
        ".csv",
        ".tsv",
        ".json",
        ".xml",
        ".yaml",
        ".yml",
        ".pdf",
        ".docx",
        ".xlsx"
      ]
    }
  ],
  "Validator": "Iban",
  "EnableLlmValidation": false
}
