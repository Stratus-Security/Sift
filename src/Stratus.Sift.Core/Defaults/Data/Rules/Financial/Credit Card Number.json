{
  "Name": "Credit Card Number",
  "Description": "Detects valid Credit Card numbers (Visa, MC, Amex, Discover) with Luhn validation",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})\\b",
        "\\b(?:4[0-9]{3}(?:[ -]?[0-9]{4}){3}|5[1-5][0-9]{2}(?:[ -]?[0-9]{4}){3}|3[47][0-9]{2}[ -]?[0-9]{6}[ -]?[0-9]{5}|6(?:011|5[0-9]{2})(?:[ -]?[0-9]{4}){3})\\b"
      ],
      "IncludedExtensions": [
        ".txt",
        ".log",
        ".csv"
      ]
    }
  ],
  "Validator": "Luhn"
}
