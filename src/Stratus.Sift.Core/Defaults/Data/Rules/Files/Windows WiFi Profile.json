{
  "Name": "Windows WiFi Profile",
  "Description": "Detects exported Windows WiFi profiles containing key material (potentially cleartext)",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "keyMaterial",
        "WLANProfile"
      ],
      "Patterns": [
        "(?<=<keyMaterial>)[^<]+(?=</keyMaterial>)"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
