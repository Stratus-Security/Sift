{
  "Name": "Password Manager Artifact",
  "Description": "Detects password manager databases and related vault artifacts by file extension.",
  "Label": "Files",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "FileExtension",
      "IsLiteral": true,
      "Patterns": [
        ".kdbx",
        ".kdb",
        ".psafe3",
        ".kwallet",
        ".keychain",
        ".agilekeychain",
        ".cred"
      ]
    }
  ],
  "EnableLlmValidation": false
}
