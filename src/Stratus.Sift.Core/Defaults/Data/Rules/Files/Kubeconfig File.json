{
  "Name": "Kubeconfig File",
  "Description": "Detects Kubernetes configuration files containing credentials (users/contexts)",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "kind: Config",
        "clusters:",
        "users:"
      ],
      "Patterns": [
        "apiVersion:\\s*v1[\\s\\S]*kind:\\s*Config"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
