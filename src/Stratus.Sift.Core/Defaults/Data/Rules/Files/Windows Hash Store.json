{
  "Name": "Windows Hash Store",
  "Description": "Detects Windows hash store and registry hive files by filename.",
  "Label": "Files",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "FileName",
      "IsLiteral": true,
      "CaseSensitive": true,
      "Patterns": [
        "NTDS.DIT",
        "SYSTEM",
        "SAM",
        "SECURITY"
      ]
    }
  ],
  "EnableLlmValidation": false
}
