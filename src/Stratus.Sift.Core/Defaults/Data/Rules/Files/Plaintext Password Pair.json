{
  "Name": "Plaintext Password Pair",
  "Description": "Detects 'username' and 'password' assignments on the same line (common in dumps/logs)",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "username",
        "user",
        "login",
        "email"
      ],
      "Patterns": [
        "(?im)(?:username|user|login|email)\\s*[:=]\\s+([^\\s\"'`;,\\r\\n]{2,64})\\s+(?:password|pass|pwd|secret)\\s*[:=]\\s+([^\\s\"'`;,\\r\\n]{3,128})(?![\\s]*['\"`;])(?!\\s*(?:null|true|false|undefined|\\*{3,}))"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
