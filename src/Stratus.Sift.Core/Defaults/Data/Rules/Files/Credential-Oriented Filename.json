{
  "Name": "Credential-Oriented Filename",
  "Description": "Detects filenames containing generic secret or password-management terms.",
  "Label": "Files",
  "Severity": "Low",
  "Matches": [
    {
      "Target": "FileName",
      "Patterns": [
        ".*passw.*",
        ".*secret.*",
        ".*credential.*",
        ".*thycotic.*",
        ".*cyberark.*"
      ]
    }
  ],
  "EnableLlmValidation": false,
  "ExcludePaths": [
    "Windows\\debug\\PASSWD.LOG",
    "*\\Windows\\debug\\PASSWD.LOG"
  ]
}
