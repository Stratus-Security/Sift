{
  "Name": "RDP Saved Credential",
  "Description": "Detects Windows Remote Desktop (RDP) files containing saved, reversible password hashes",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "password 51:"
      ],
      "Patterns": [
        "password 51:(b|s):[0-9A-Fa-f]+"
      ],
      "ExtensionProfile": "SourceAndConfig",
      "IncludedExtensions": [
        ".rdp"
      ]
    }
  ],
  "EnableLlmValidation": false
}
