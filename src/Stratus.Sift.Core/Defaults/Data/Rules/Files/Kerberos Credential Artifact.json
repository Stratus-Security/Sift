{
  "Name": "Kerberos Credential Artifact",
  "Description": "Detects Kerberos credential caches and keytabs by filename or extension.",
  "Severity": "Medium",
  "Matches": [
    {
      "Target": "FileExtension",
      "IsLiteral": true,
      "Patterns": [
        ".keytab",
        ".CCACHE"
      ]
    },
    {
      "Target": "FileName",
      "Patterns": [
        "krb5cc_.*"
      ]
    }
  ],
  "EnableLlmValidation": false
}
