{
  "ReportFinding": false,
  "Name": "Unattend XML File",
  "Description": "Looks inside unattended installation files for embedded administrator or autologon passwords.",
  "Matches": [
    {
      "Target": "FileName",
      "IsLiteral": true,
      "Patterns": [
        "unattend.xml",
        "autounattend.xml"
      ]
    }
  ],
  "EnableLlmValidation": false,
  "SubRules": [
    {
      "Name": "Unattend Password",
      "Description": "Detects administrator or autologon passwords embedded in unattended installation files.",
      "Severity": "High",
      "Matches": [
        {
          "Target": "Content",
          "Patterns": [
            "(?s)<AdministratorPassword>.{0,30}<Value>.*?<\\/Value>",
            "(?s)<AutoLogon>.{0,30}<Value>.*?<\\/Value>"
          ],
          "Keywords": [
            "AdministratorPassword",
            "AutoLogon"
          ]
        }
      ],
      "EnableLlmValidation": false
    }
  ]
}
