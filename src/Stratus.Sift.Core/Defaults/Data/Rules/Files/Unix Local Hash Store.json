{
  "Name": "Unix Local Hash Store",
  "Description": "Detects local Unix password and hash store files by filename.",
  "Label": "Files",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "FileName",
      "IsLiteral": true,
      "CaseSensitive": true,
      "Patterns": [
        "shadow",
        "pwd.db",
        "passwd"
      ]
    }
  ],
  "EnableLlmValidation": false
}
