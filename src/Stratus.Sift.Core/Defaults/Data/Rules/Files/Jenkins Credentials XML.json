{
  "Name": "Jenkins Credentials XML",
  "Description": "Detects Jenkins credentials configuration files (potentially containing encrypted secrets)",
  "Label": "General",
  "Severity": "High",
  "Matches": [
    {
      "Target": "FileName",
      "IsLiteral": true,
      "Patterns": [
        "jenkins.plugins.publish_over_ssh.BapSshPublisherPlugin.xml",
        "credentials.xml"
      ]
    },
    {
      "Target": "Content",
      "Keywords": [
        "com.cloudbees.plugins.credentials.impl"
      ],
      "Patterns": [
        "<com\\.cloudbees\\.plugins\\.credentials\\.impl\\.UsernamePasswordCredentialsImpl>"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
