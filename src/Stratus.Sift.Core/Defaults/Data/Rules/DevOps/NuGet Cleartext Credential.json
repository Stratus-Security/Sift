{
  "Name": "NuGet Cleartext Credential",
  "Description": "Detects cleartext package-source passwords stored in NuGet.Config files.",
  "Label": "DevOps",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "ClearTextPassword",
        "packageSourceCredentials"
      ],
      "Patterns": [
        "<add\\s+key=[\"']ClearTextPassword[\"']\\s+value=[\"'][^\"']{4,}[\"']\\s*/?>"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
