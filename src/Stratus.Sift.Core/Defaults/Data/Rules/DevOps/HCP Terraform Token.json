{
  "Name": "HCP Terraform Token",
  "Description": "Detects current tftk and legacy atlasv1 HCP Terraform or Terraform Enterprise API tokens.",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "tftk.",
        ".atlasv1.",
        "TF_TOKEN_"
      ],
      "Patterns": [
        "(?<![A-Za-z0-9_.-])tftk\\.[A-Za-z0-9_.-]{16,1024}(?![A-Za-z0-9_.-])",
        "(?<![A-Za-z0-9_.-])[A-Za-z0-9_-]{8,}\\.atlasv1\\.[A-Za-z0-9_.-]{20,1024}(?![A-Za-z0-9_.-])"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "TerraformToken"
}
