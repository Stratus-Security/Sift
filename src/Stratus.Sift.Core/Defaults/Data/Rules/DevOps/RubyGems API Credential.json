{
  "Name": "RubyGems API Credential",
  "Description": "Detects API credentials stored in RubyGems credential files.",
  "Label": "DevOps",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        ":rubygems_api_key:",
        "rubygems_api_key"
      ],
      "Patterns": [
        "(?m)^\\s*:rubygems_api_key:\\s+[A-Za-z0-9_-]{20,512}\\s*$"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
