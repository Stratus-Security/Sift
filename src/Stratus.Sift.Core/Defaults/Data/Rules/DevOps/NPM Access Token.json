{
  "Name": "NPM Access Token",
  "Description": "Detects NPM Access Tokens (npm_ prefix)",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "npm_"
      ],
      "Patterns": [
        "\\bnpm_[a-zA-Z0-9]{36}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "NpmAccessToken"
}
