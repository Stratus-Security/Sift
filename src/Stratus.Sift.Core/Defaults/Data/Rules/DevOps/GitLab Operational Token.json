{
  "Name": "GitLab Operational Token",
  "Description": "Detects GitLab OAuth, deploy, runner, job, trigger, feed, mail, agent, workspace, SCIM, and feature-flag tokens.",
  "Label": "DevOps",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "gloas-",
        "gldt-",
        "glrt-",
        "glrtr-",
        "glcbt-",
        "glptt-",
        "glft-",
        "glimt-",
        "glagent-",
        "glwt-",
        "glsoat-",
        "glffct-"
      ],
      "Patterns": [
        "(?<![A-Za-z0-9_-])(?:gloas|gldt|glrt|glrtr|glcbt|glptt|glft|glimt|glagent|glwt|glsoat|glffct)-[A-Za-z0-9_-]{12,512}(?![A-Za-z0-9_-])"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "GitLabOperationalToken"
}
