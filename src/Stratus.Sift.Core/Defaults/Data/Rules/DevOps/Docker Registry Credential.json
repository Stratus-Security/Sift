{
  "Name": "Docker Registry Credential",
  "Description": "Detects Base64-encoded username and secret pairs stored in Docker config auth entries.",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "\"auths\"",
        "\"auth\""
      ],
      "Patterns": [
        "\"auth\"\\s*:\\s*\"[A-Za-z0-9+/]{8,}={0,2}\""
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "DockerConfigAuth"
}
