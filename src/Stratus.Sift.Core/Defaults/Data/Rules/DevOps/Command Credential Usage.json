{
  "Name": "Command Credential Usage",
  "Description": "Detects inline credential values in CMD and batch command arguments or assignments.",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "(?:^|[ \\t])[-/][A-Za-z0-9_-]*(?:password|passwd)[A-Za-z0-9_-]*(?:[ \\t]+|[:=])(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\\r\\n]+)",
        "\\bpasswo?r?d[ \\t]*=[ \\t]*(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+')",
        "\\bschtasks(?:\\.exe)?\\b[^\\r\\n]{0,300}[ \\t]/(?:rp|p)[ \\t]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\\r\\n]+)",
        "\\bnet[ \\t]+user[ \\t]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s/\\r\\n]+)[ \\t]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s/\\r\\n]+)",
        "\\bpsexec(?:\\.exe)?\\b[^\\r\\n]{0,100}[ \\t]-p[ \\t]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\\r\\n]+)",
        "\\bnet[ \\t]+use[ \\t]+(?:[A-Za-z]:[ \\t]+|\\*[ \\t]+)?\\\\\\\\[^\\s\\r\\n]+[ \\t]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s/\\r\\n]+)",
        "\\bnet[ \\t]+use\\b[^\\r\\n]{0,200}[ \\t]/user:[^\\s\\r\\n]+(?:[ \\t]+/[^\\s\\r\\n]+){0,4}[ \\t]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s/\\r\\n]+)",
        "\\bcmdkey(?:\\.exe)?\\b[^\\r\\n]{0,300}[ \\t]/pass(?:word)?[:=][ \\t]*(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\\r\\n]+)"
      ],
      "Keywords": [
        "password",
        "passwd",
        "passwrd",
        "passwod",
        "schtasks",
        "psexec",
        "net ",
        "net\t",
        "cmdkey"
      ],
      "IncludedExtensions": [
        ".bat",
        ".cmd"
      ]
    }
  ],
  "Validator": "CommandCredentialUsage"
}
