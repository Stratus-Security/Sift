{
  "Name": "PowerShell Credential Usage",
  "Description": "Detects PowerShell plaintext conversion, credential materialization, and potentially recoverable secure-string handling.",
  "Severity": "High",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "-SecureString",
        "-AsPlainText",
        "\\[(?:System\\.)?Net\\.NetworkCredential\\]::new\\(",
        "New-Object\\s+(?:-TypeName\\s+)?(?:System\\.)?Net\\.NetworkCredential",
        "\\.GetNetworkCredential\\(\\)\\.Password",
        "\\[(?:System\\.)?Runtime\\.InteropServices\\.Marshal\\]::SecureStringToBSTR\\("
      ],
      "IncludedExtensions": [
        ".ps1",
        ".psd1",
        ".psm1"
      ]
    }
  ],
  "Validator": "PowerShellCredentialUsage"
}
