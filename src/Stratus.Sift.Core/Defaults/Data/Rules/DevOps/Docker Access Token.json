{
  "Name": "Docker Access Token",
  "Description": "Detects Docker Hub personal and organization access tokens.",
  "Label": "DevOps",
  "Severity": "Critical",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "dckr_pat_",
        "dckr_oat_"
      ],
      "Patterns": [
        "(?<![A-Za-z0-9_-])dckr_(?:pat|oat)_[A-Za-z0-9_-]{12,512}(?![A-Za-z0-9_-])"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "Validator": "DockerAccessToken"
}
