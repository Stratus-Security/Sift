{
  "Name": "Shell History",
  "Description": "Detects shell history files which may contain executed commands with secrets",
  "Label": "General",
  "Matches": [
    {
      "Target": "FileName",
      "IsLiteral": true,
      "Patterns": [
        ".bash_history",
        ".zsh_history",
        ".sh_history",
        "zhistory",
        ".irb_history",
        "ConsoleHost_History.txt",
        "Visual Studio Code Host_history.txt"
      ]
    }
  ],
  "EnableLlmValidation": false
}
