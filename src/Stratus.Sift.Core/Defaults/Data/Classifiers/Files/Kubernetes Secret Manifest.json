{
  "Name": "Kubernetes Secret Manifest",
  "Description": "Detects Kubernetes Secret manifests containing data or stringData entries.",
  "Label": "Files",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": ["kind: Secret", "stringData:", "data:"],
      "Patterns": ["(?m)^kind:\\s*Secret\\s*$[\\s\\S]{0,4000}^\\s*(?:data|stringData):\\s*(?:$|\\{)[\\s\\S]{0,2000}^\\s+[A-Za-z0-9_.-]+:\\s*\\S+"],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
