{
  "Name": "Passport Number (Contextual)",
  "Description": "Opt-in contextual detection of passport identifiers without assuming a single country's format.",
  "Label": "Identity",
  "Validator": "ContextualIdentifier",
  "AllowEvidenceCollection": true,
  "Matches": [
    {
      "Target": "Content",
      "Keywords": ["passport_number", "passport number", "passportNo"],
      "Patterns": ["(?:passport[_ ]?(?:number|no))\\s*[:=]\\s*[\"']?[A-Z0-9]{6,12}[\"']?"],
      "IncludedExtensions": [".txt", ".log", ".csv", ".tsv", ".json", ".xml", ".yaml", ".yml", ".pdf", ".docx", ".xlsx"]
    }
  ],
  "EnableLlmValidation": false
}
