{
  "Name": "Medical Record Number (Contextual)",
  "Description": "Opt-in contextual detection of medical record and patient identifiers.",
  "Label": "Identity",
  "Validator": "ContextualIdentifier",
  "AllowEvidenceCollection": true,
  "Matches": [
    {
      "Target": "Content",
      "Keywords": ["medical_record_number", "medical record number", "MRN", "patient_id"],
      "Patterns": ["(?:medical[_ ]?record[_ ]?(?:number|no)|MRN|patient_id)\\s*[:=]\\s*[\"']?[A-Z0-9-]{5,32}[\"']?"],
      "IncludedExtensions": [".txt", ".log", ".csv", ".tsv", ".json", ".xml", ".yaml", ".yml", ".pdf", ".docx", ".xlsx"]
    }
  ],
  "EnableLlmValidation": false
}
