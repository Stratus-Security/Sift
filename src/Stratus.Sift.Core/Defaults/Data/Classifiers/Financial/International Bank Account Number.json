{
  "Name": "International Bank Account Number",
  "Description": "Opt-in detection of checksum-valid International Bank Account Numbers (IBANs).",
  "Label": "Financial",
  "Validator": "Iban",
  "AllowEvidenceCollection": true,
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Patterns": ["(?<![A-Z0-9])[A-Z]{2}[0-9]{2}(?:[ ]?[A-Z0-9]){11,30}(?![A-Z0-9])"],
      "IncludedExtensions": [".txt", ".log", ".csv", ".tsv", ".json", ".xml", ".yaml", ".yml", ".pdf", ".docx", ".xlsx"]
    }
  ],
  "EnableLlmValidation": false
}
