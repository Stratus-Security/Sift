{
  "Name": "Credit Card Number",
  "Description": "Detects valid Credit Card numbers (Visa, MC, Amex, Discover) with Luhn validation",
  "Label": "General",
  "Validator": "Luhn",
  "AllowEvidenceCollection": true,
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "visa",
        "mastercard",
        "amex",
        "discover",
        "cc_number",
        "card",
        "stripe",
        "payment",
        "billing",
        "cvv",
        "expiration"
      ],
      "Patterns": [
        "\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})\\b"
      ],
      "IncludedExtensions": [
        ".txt",
        ".log",
        ".csv"
      ]
    }
  ]
}
