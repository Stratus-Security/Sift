{
  "Name": "Credentialed Service URI",
  "Description": "Detects MySQL, MariaDB, Redis, AMQP, RabbitMQ, Neo4j, and Bolt URIs containing embedded usernames and passwords.",
  "Label": "Database",
  "Validator": "CredentialedServiceUri",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": ["mysql://", "mariadb://", "redis://", "rediss://", "amqp://", "amqps://", "neo4j://", "bolt://"],
      "Patterns": ["\\b(?:mysql|mariadb|redis|rediss|amqp|amqps|neo4j(?:\\+s|\\+ssc)?|bolt(?:\\+s|\\+ssc)?)://[^\\s/@:]+:[^\\s/@]+@[^\\s/]+[^\\s\"'`,;)]*"],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
