{
  "Name": "SQL Account Creation Statement",
  "Description": "Detects SQL account creation statements that embed or accompany credential material.",
  "Label": "Database",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "CREATE (USER|LOGIN) .{0,200} (IDENTIFIED BY|WITH PASSWORD)"
      ],
      "Keywords": [
        "CREATE USER",
        "CREATE LOGIN",
        "IDENTIFIED BY",
        "WITH PASSWORD"
      ],
      "ExtensionProfile": "SourceAndConfig",
      "IncludedExtensions": [
        ".sh"
      ]
    }
  ]
}
