{
  "Name": "Environment Secret Assignment",
  "Description": "Detects credible opaque values assigned to common environment-style secret, token, password, key, and credential names.",
  "Label": "DevOps",
  "Validator": "EnvironmentSecretAssignment",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "(?:^|[\\s{,])[\"']?(?:[A-Z][A-Z0-9_\\-.]*)?(?:API[_\\-.]?KEY|CLIENT[_\\-.]?SECRET|ACCESS[_\\-.]?TOKEN|AUTH[_\\-.]?TOKEN|REFRESH[_\\-.]?TOKEN|PRIVATE[_\\-.]?KEY|PASSWORD|PASSWD|CREDENTIALS?|SECRET|TOKEN)[\"']?\\s*[:=]\\s*[\"'`]?[^\\s\"'`{},]{12,}"
      ],
      "Keywords": [
        "apikey",
        "api_key",
        "credential",
        "password",
        "private_key",
        "secret",
        "token"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ],
  "EnableLlmValidation": false
}
