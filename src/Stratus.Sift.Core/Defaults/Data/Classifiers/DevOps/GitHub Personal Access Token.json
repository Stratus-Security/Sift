{
  "Name": "GitHub Personal Access Token",
  "Description": "Detects GitHub Personal Access Tokens (Classic ghp_ and Fine-Grained github_pat_)",
  "Label": "General",
  "Validator": "GitHubPat",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "ghp_",
        "gho_",
        "ghu_",
        "ghs_",
        "ghr_",
        "github_pat_"
      ],
      "Patterns": [
        "\\b((ghp|gho|ghu|ghs|ghr)_[a-zA-Z0-9]{36,255}|github_pat_[a-zA-Z0-9_]{82,})\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
