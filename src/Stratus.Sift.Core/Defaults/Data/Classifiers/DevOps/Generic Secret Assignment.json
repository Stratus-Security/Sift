{
  "Name": "Generic Secret Assignment",
  "Description": "Detects broad secret-assignment patterns in code and configuration when provider-specific rules do not apply.",
  "Label": "DevOps",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "passw?o?r?d\\s*[:=]\\s*['\\\"][^'\\\"$]....",
        "api[Kk]ey\\s*[:=]\\s*['\\\"][^'\\\"$]....",
        "passw?o?r?d?>\\s*[^\\s<]+\\s*<",
        "passw?o?r?d?>.{3,2000}</pass",
        "[\\s]+-pass(?:word)?(?:\\s|[:=]|$)",
        "api[kK]ey>\\s*[^\\s<]+\\s*<",
        "[_\\-\\.]oauth\\s*[:=]\\s*['\\\"][^'\\\"$]....",
        "<ExtendedMatchKey>ClientAuth",
        "GIUserPassword"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
