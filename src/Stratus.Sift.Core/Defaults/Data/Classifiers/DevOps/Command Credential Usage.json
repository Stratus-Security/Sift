{
  "Name": "Command Credential Usage",
  "Description": "Detects CMD and batch script patterns that commonly embed or pass credentials on the command line.",
  "Label": "DevOps",
  "Matches": [
    {
      "Target": "Content",
      "Patterns": [
        "passwo?r?d\\s*=\\s*['\\\"][^'\\\"]....",
        "schtasks.{1,300}(/rp\\s|/p\\s)",
        "net user ",
        "psexec .{0,100} -p ",
        "net use .{0,300} /user:",
        "cmdkey "
      ],
      "IncludedExtensions": [
        ".bat",
        ".cmd"
      ]
    }
  ]
}
