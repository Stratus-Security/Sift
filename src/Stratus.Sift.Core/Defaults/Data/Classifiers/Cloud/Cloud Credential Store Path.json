{
  "Name": "Cloud Credential Store Path",
  "Description": "Detects common local cloud credential store paths such as AWS and doctl configuration locations.",
  "Label": "Cloud",
  "Matches": [
    {
      "Target": "DirectoryPath",
      "Patterns": [
        "[\\\\/]\\.aws[\\\\/]",
        "[\\\\/]\\.aws[\\\\/](?:credentials|cli[\\\\/]cache[\\\\/][^\\\\/]+\\.json|sso[\\\\/]cache[\\\\/][^\\\\/]+\\.json|login[\\\\/]cache[\\\\/][^\\\\/]+\\.json)$",
        "[\\\\/]\\.azure[\\\\/](?:accessTokens\\.json|msal_token_cache\\.(?:json|bin)|service_principal_entries\\.json)$",
        "[\\\\/]doctl[\\\\/]config\\.yaml$",
        "[\\\\/]gcloud[\\\\/]application_default_credentials\\.json$",
        "[\\\\/]gcloud[\\\\/](?:credentials|access_tokens)\\.db$",
        "[\\\\/]gcloud[\\\\/]legacy_credentials[\\\\/][^\\\\/]+[\\\\/]adc\\.json$",
        "(?:[\\\\/]\\.oci|[\\\\/]\\.config[\\\\/]oci)[\\\\/](?:config|oci_cli_rc|sessions[\\\\/].*[\\\\/](?:token|security_token))$",
        "[\\\\/]\\.terraform\\.d[\\\\/]credentials\\.tfrc\\.json$",
        "[\\\\/]\\.docker[\\\\/]config\\.json$",
        "[\\\\/](?:gh|GitHub CLI)[\\\\/]hosts\\.yml$"
      ]
    }
  ],
  "EnableLlmValidation": false
}
