{
  "Name": "Azure Client Secret",
  "Description": "Detects Azure Service Principal Client Secrets in configuration (by context)",
  "Label": "General",
  "EntropyThreshold": 4.5,
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "client_secret",
        "ClientSecret",
        "client-secret"
      ],
      "Patterns": [
        "(?<=(client_secret|ClientSecret|client-secret)\"?'?\\s*[:=]\\s*[\"'])[a-zA-Z0-9~\\-_\\.]{30,}"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
