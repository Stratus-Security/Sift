{
  "Name": "Azure SAS Token",
  "Description": "Detects Azure Shared Access Signature (SAS) tokens",
  "Label": "General",
  "Validator": "AzureSas",
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "sig=",
        "sv="
      ],
      "Patterns": [
        "(?<=[?&]sig=)[a-zA-Z0-9%+\\/=]{43,}"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
