{
  "Name": "Azure Storage Account Key",
  "Description": "Detects standalone Azure Storage account keys assigned directly in configuration or environment files.",
  "Label": "General",
  "EntropyThreshold": 4.5,
  "Matches": [
    {
      "Target": "Content",
      "Keywords": [
        "AZURE_STORAGE_KEY",
        "StorageAccountKey",
        "azure_storage_key"
      ],
      "Patterns": [
        "(?<=(AZURE_STORAGE_KEY|AzureStorageKey|StorageAccountKey|storage_account_key|azure_storage_key)\"?'?\\s*[:=]\\s*[\"']?)[A-Za-z0-9+/]{86,88}={0,2}"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
