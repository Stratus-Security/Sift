{
  "Name": "Google OAuth Access Token",
  "Description": "Detects Google OAuth 2.0 Access Tokens (ya29 prefix)",
  "Label": "General",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "ya29."
      ],
      "Patterns": [
        "\\bya29\\.[0-9a-zA-Z_\\-]{20,}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
