{
  "Name": "SendGrid API Key",
  "Description": "Detects SendGrid API Keys (SG. prefix)",
  "Label": "General",
  "Validator": "SendGridApiKey",
  "Matches": [
    {
      "Target": "Content",
      "CaseSensitive": true,
      "Keywords": [
        "SG."
      ],
      "Patterns": [
        "\\bSG\\.[a-zA-Z0-9_-]{20,25}\\.[a-zA-Z0-9_-]{40,50}\\b"
      ],
      "ExtensionProfile": "SourceAndConfig"
    }
  ]
}
