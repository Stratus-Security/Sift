<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sift</AssemblyName>
    <RootNamespace>Stratus.Sift.Cli</RootNamespace>
    <Version>0.3.0</Version>
    <IsPackable>false</IsPackable>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != ''">true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <StripSymbols>true</StripSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stratus.Sift.Core\Stratus.Sift.Core.csproj" />
    <ProjectReference Include="..\Stratus.Sift.Contracts\Stratus.Sift.Contracts.csproj" />
    <ProjectReference Include="..\Stratus.Sift.FileSystem\Stratus.Sift.FileSystem.csproj" />
    <ProjectReference Include="..\Stratus.Sift.Connectors\Stratus.Sift.Connectors.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" Condition="'$(PublishAot)' != 'true'" />
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.10" />
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
  </ItemGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);SIFT_NATIVE_AOT</DefineConstants>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Compile Remove="SlackBrowserConnector.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stratus.Sift.Cli.Tests" />
  </ItemGroup>
</Project>
